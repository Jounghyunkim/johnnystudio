# 개발 PC 에서 진짜 로그인 메일을 보내 보는 설정 (deploy/README.md §3-5)
#
#   install -m 600 api/.env.local.example api/.env.local     ← 복사 (권한 600: 나만 읽는다)
#   nano api/.env.local                                      ← 아래에서 쓰는 메일 하나만 주석(#)을 풀고 채운다
#   ./scripts/dev.sh                                         ← 다시 띄우면 적용된다
#
# api/.env.local 은 git 에 올라가지 않는다. 비밀번호는 로그인 비밀번호가 아니라 "앱 비밀번호" 다.
# 메일만 시험: cd api && .venv/bin/python -m app.check_config .env.local --no-db --send-test 받을주소@example.com

JOHNNYSTUDIO_MAIL_BACKEND=smtp

# ── Gmail ──────────────────────────────────────────────
# 준비: 2단계 인증 켜기 → https://myaccount.google.com/apppasswords 에서 앱 비밀번호(16자) 만들기
# JOHNNYSTUDIO_SMTP_HOST=smtp.gmail.com
# JOHNNYSTUDIO_SMTP_PORT=587
# JOHNNYSTUDIO_SMTP_SECURITY=starttls
# JOHNNYSTUDIO_SMTP_USER=내주소@gmail.com
# JOHNNYSTUDIO_SMTP_PASSWORD=앱비밀번호16자를띄어쓰기없이
# JOHNNYSTUDIO_MAIL_FROM=JohnnyStudio <내주소@gmail.com>

# ── 네이버 ─────────────────────────────────────────────
# 준비: 네이버 메일 → 환경설정 → POP3/IMAP 설정 → "IMAP/SMTP 사용" 켜기
#       2단계 인증을 쓰면 네이버 보안 설정에서 애플리케이션 비밀번호를 만들어 쓴다
# JOHNNYSTUDIO_SMTP_HOST=smtp.naver.com
# JOHNNYSTUDIO_SMTP_PORT=587
# JOHNNYSTUDIO_SMTP_SECURITY=starttls
# JOHNNYSTUDIO_SMTP_USER=아이디@naver.com
# JOHNNYSTUDIO_SMTP_PASSWORD=비밀번호또는애플리케이션비밀번호
# JOHNNYSTUDIO_MAIL_FROM=JohnnyStudio <아이디@naver.com>
