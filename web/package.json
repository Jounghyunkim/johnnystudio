{
  "name": "johnnystudio-web",
  "version": "0.1.0",
  "private": true,
  "description": "JohnnyStudio 포털(허브) 웹 프론트엔드: Next.js 정적 내보내기 (회원 API 는 ../api)",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/inject-csp.mjs out",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "marked": "18.1.1",
    "next": "16.4.2",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
