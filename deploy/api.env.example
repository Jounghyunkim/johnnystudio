# JohnnyStudio API 운영 설정: /opt/johnnystudio/api.env 로 복사해서 채운다 (deploy/README.md §3)
#   install -m 600 deploy/api.env.example /opt/johnnystudio/api.env
# 이 파일에는 비밀값이 들어가므로 커밋하지 않는다. 형식: systemd EnvironmentFile (따옴표 없이 KEY=VALUE)
# 설정 항목의 뜻: api/app/config.py

JOHNNYSTUDIO_ENV=production
# 방문자가 보는 사이트 주소 (메일 링크와 CSRF 검사에 쓴다). https:// 여야 한다 [확인 필요: 도메인]
JOHNNYSTUDIO_SITE_URL=https://__DOMAIN__
# www 주소로도 들어온다면 함께 적는다 (쉼표로 구분)
JOHNNYSTUDIO_EXTRA_ORIGINS=https://www.__DOMAIN__
# 무작위 비밀값 (IP 해시용). 만들기: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JOHNNYSTUDIO_SECRET=

# PostgreSQL (§3-1 에서 만든 역할·DB). Arkurator 의 DB 와 따로다
JOHNNYSTUDIO_DATABASE_URL=postgresql+psycopg://johnnystudio:비밀번호@127.0.0.1:5432/johnnystudio

# 메일 발송 (SMTP). 발송 서비스는 아직 정하지 않았다 [확인 필요]. deploy/README.md §3-5 참고
JOHNNYSTUDIO_MAIL_BACKEND=smtp
JOHNNYSTUDIO_MAIL_FROM=JohnnyStudio <noreply@__DOMAIN__>
JOHNNYSTUDIO_SMTP_HOST=
JOHNNYSTUDIO_SMTP_PORT=587
# starttls(587) | ssl(465) | none
JOHNNYSTUDIO_SMTP_SECURITY=starttls
JOHNNYSTUDIO_SMTP_USER=
JOHNNYSTUDIO_SMTP_PASSWORD=
